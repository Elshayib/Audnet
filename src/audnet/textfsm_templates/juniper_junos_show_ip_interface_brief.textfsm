Value Required INTERFACE (\S+)
Value ADMIN_STATUS (\S+)
Value LINK_STATUS (\S+)
Value PROTO (\S+)
Value IP_ADDRESS (\S+)

Start
 # Skip header row: Interface Admin Link Proto Local Remote
 ^Interface\s+Admin\s+Link
 # show interfaces terse data lines
 # ge-0/0/0  up  up  inet  10.0.0.1/24
 ^\s*${INTERFACE}\s+${ADMIN_STATUS}\s+${LINK_STATUS}\s+${PROTO}\s+${IP_ADDRESS}(?:\s+\S+)*\s*$$ -> Record
 # Interface without address (or with only admin/link)
 ^\s*${INTERFACE}\s+${ADMIN_STATUS}\s+${LINK_STATUS}\s*$$ -> Record
 # Continuation lines for additional families
 ^\s+${PROTO}\s+${IP_ADDRESS}(?:\s+\S+)*\s*$$ -> Record
