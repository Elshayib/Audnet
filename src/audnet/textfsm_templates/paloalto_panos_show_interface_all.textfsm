Value Required INTERFACE (\S+)
Value ID (\d+)
Value SPEED_DUPLEX (\S+)
Value MAC (\S+)
Value VSYS (\S+)
Value ZONE (\S+)
Value FORWARDING (\S+)
Value TAG (\S+)
Value IP_ADDRESS (\S+)

Start
 # Detect logical section header
 ^total configured logical -> Logical
 # Hardware data lines: ethernet1/1  1  1000/full/up  00:1b:17:00:01:01
 ^${INTERFACE}\s+${ID}\s+${SPEED_DUPLEX}\s+${MAC}\s*$$ -> Record
 # Skip headers/separators
 ^name\s+id
 ^-+
 ^total configured hardware
 ^\s*$$

Logical
 # ethernet1/1  1  1  trust  vr:default  10  10.0.0.1/24
 ^${INTERFACE}\s+${ID}\s+${VSYS}\s+${ZONE}\s+${FORWARDING}\s+${TAG}\s+${IP_ADDRESS}\s*$$ -> Record
 ^name\s+id
 ^-+
 ^\s*$$
